{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      ".storybook/**",
      "compiled/**",
      "registry/**",
      "scripts/**",
      "stories/**",
      "tokens/**",
      "*.ts",
      "*.json",
      "!public/r",
      "!dist",
      "!node_modules"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useConst": "error", "noNonNullAssertion": "error" },
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["registry/**", "compiled/**"],
      "plugins": ["./no-negation.grit"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "noUnusedImports": "error",
            "noUnusedVariables": "error",
            "noUnusedFunctionParameters": "error"
          },
          "style": {
            "useImportType": "error",
            "useBlockStatements": "error",
            "noMagicNumbers": "error",
            "noCommonJs": "error",
            "noEnum": "error",
            "noNamespace": "error",
            "noParameterProperties": "error",
            "useFilenamingConvention": {
              "level": "error",
              "options": { "filenameCases": ["kebab-case"] }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": { "rules": { "style": { "noMagicNumbers": "off" } } }
    },
    {
      "includes": [
        "compiled/color-picker.tsx",
        "compiled/field.tsx",
        "compiled/radio-group.tsx",
        "compiled/segmented.tsx"
      ],
      "linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
