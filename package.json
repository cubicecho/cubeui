{
  "name": "@cubicecho/cubeui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A shadcn registry of React Native components and the tokens they share with the web.",
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "parity": "node scripts/check-cubeui-parity.mjs",
    "compile": "node scripts/rn2web/index.mjs",
    "compile:check": "node scripts/rn2web/index.mjs --check",
    "registry:build": "shadcn build registry.web.json -o public/r && shadcn build -o public/r/native",
    "registry:check": "node scripts/check-registry-build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "storybook": "storybook dev -p 3001",
    "build-storybook": "storybook build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test scripts/ && vitest run",
    "build": "npm run tokens:build && npm run compile && npm run typecheck && npm run registry:build && npm run registry:check",
    "check": "npm run tokens:check && npm run parity && npm run compile:check && npm run typecheck && npm run registry:check && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://cubicecho.github.io/cubeui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubicecho/cubeui.git"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^5.0.0-rc.0",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-svg": "^15.13.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-native-web-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser-playwright": "^4.1.11",
    "cmdk": "^1.1.1",
    "playwright": "^1.63.0",
    "react-native-web": "^0.21.2",
    "shadcn": "^4.20.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
