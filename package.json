{
  "name": "@cubicecho/cubeui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A shadcn registry of layout and form shells for the cubicecho apps.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run registry:build && vite build",
    "preview": "vite preview",
    "registry:build": "shadcn build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
